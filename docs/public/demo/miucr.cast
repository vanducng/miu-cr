[0.034, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"applicable\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[\u001b[1;39m{\u001b[0m\u001b[1;34m\"always_apply\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"description\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"Baseline correctness checks for any change.\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"globs\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;90mnull\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"path\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"defaults/correctness.md\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"provenance\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"builtin-default\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"stem\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"correctness\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"trusted\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m,\u001b[1;39m{\u001b[0m\u001b[1;34m\"always_apply\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"description\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"Baseline performance checks for any change.\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"globs\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;90mnull\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"path\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"defaults/performance.md\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"provenance\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"builtin-default\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"stem\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"performance\"\u001b[0"]
[0.000, "o", "m\u001b[1;39m,\u001b[0m\u001b[1;34m\"trusted\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m,\u001b[1;39m{\u001b[0m\u001b[1;34m\"always_apply\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"description\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"Baseline reliability checks for any change.\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"globs\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;90mnull\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"path\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"defaults/reliability.md\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"provenance\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"builtin-default\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"stem\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"reliability\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"trusted\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m,\u001b[1;39m{\u001b[0m\u001b[1;34m\"always_apply\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"description\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"Baseline security checks for any change.\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"globs\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;90mnull\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"path\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"defaults/security.md\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"provenance\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"builtin-default\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"stem\"\u001b[0m\u001b[1;39m:\u001b"]
[0.000, "o", "[0m\u001b[0;32m\"security\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"trusted\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m,\u001b[1;39m{\u001b[0m\u001b[1;34m\"always_apply\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"description\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"Baseline testing checks for any change.\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"globs\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;90mnull\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"path\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"defaults/testing.md\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"provenance\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"builtin-default\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"stem\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"testing\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"trusted\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m,\u001b[1;39m{\u001b[0m\u001b[1;34m\"always_apply\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39mfalse\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"description\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"Stack review context for Go changes — async safety, error handling, and resource lifecycle.\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"globs\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[\u001b[0;32m\"**/*.go\"\u001b[0m\u001b[1;39m\u001b[1;39m]\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"path\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"defaults/go.md\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"pr"]
[0.000, "o", "ovenance\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"builtin-default\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"stem\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"go\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"trusted\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m]\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"body_only\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[]\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"loaded_count\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m12\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"path\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"api/admin.go\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"warnings\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[]\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[3.022, "o", "\u001b[H\u001b[2J\u001b[3J"]
[0.001, "o", "\u001b[2m# 2. review what you are about to commit; --gate high exits 2 on a serious finding\u001b[0m\r\n"]
